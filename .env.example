# NSTP environment variables — copy to .env and fill in.
# .env is gitignored and must NEVER be committed.
# Generate a SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF trusted origins (full scheme+host, comma-separated). Only needed in
# production behind HTTPS, e.g. https://cybaroo.onrender.com. On Render the
# host is auto-detected from RENDER_EXTERNAL_HOSTNAME, so you usually leave this
# blank. Left blank locally.
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# PostgreSQL 18. Run scripts/create_db_role.sql first (as the postgres
# superuser) to create the least-privilege `nstp` role and nstp_db.
# DB_USER is deliberately NOT the postgres superuser.
# Leave DB_ENGINE unset to fall back to SQLite for local dev.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=nstp_db
DB_USER=nstp
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Production database (Render) ---
# In production, Render provides a single DATABASE_URL and settings.py uses it
# instead of the DB_* variables above. Leave this UNSET locally.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Email ---
# Dev leaves EMAIL_BACKEND unset -> the console backend prints emails to the
# terminal. In production (Render free tier blocks SMTP), send over HTTPS with
# the Resend API backend:
#   EMAIL_BACKEND=nstp.email.ResendEmailBackend
#   RESEND_API_KEY=re_xxxxxxxx          # from resend.com
#   EMAIL_FAIL_SILENTLY=True            # a provider outage logs, never 500s
#   EMAIL_API_TIMEOUT=10                # seconds (optional; default 10)
# A traditional SMTP host still works too, if it isn't blocked:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=
#   EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@ausdais.com.au

# --- Rate limiting ---
# Set False in tests to avoid 429s.
RATELIMIT_ENABLE=True
